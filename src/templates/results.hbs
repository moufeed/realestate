 <!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <title>{{pagetitle}}</title>
    <link rel="stylesheet" href="assets/css/style-{{dir}}.min.css">
    {{>loader-scripts}}
</head>
<body>
    {{>header page_active='index' }}   
   <section class="page_header" data-parallax="scroll" data-speed="0.3" data-image-src="assets/img/results-bg.jpg">
         <div class="container"> 
             <div class="row">
                 <div class="col-sm-5 ">
                      <h1>{{search_results}}</h1>
                 </div>
                 <div class="col-sm-7 ">
                     <ol class="breadcrumb page-breadcrumb">
                    {{#isequal dir 'ltr'}}
                        <li><a href="index.html">{{home}}</a></li>
                    {{else}}
                        <li><a href="index-ltr.html">{{home}}</a></li>
                    {{/isequal}}
                    <li class="active">{{search_results}}</li>
                    </ol>
                 </div>
             </div> 
         </div>
     </section> 
 
<section class="results-page">
<div class="container">
    <div class="row">
        <div class="col-md-9 col-sm-8 col-xs-12 ">
                <div class="sort-btns clearfix"> 
                   <span class="hidden-xs">
                    <strong>{{sort_by}}</strong>   
                    <a href=""  data-sort="name"><i class="fa fa-sort" aria-hidden="true"></i> {{name}}</a>
                    <a href=""  data-sort="type"><i class="fa fa-sort" aria-hidden="true"></i> {{type}}</a>
                   </span>
                   <span class="visible-xs-block">
                       <i class="fa fa-search"></i> <b>25502</b>
                         <span>{{result_found}}</span>
                   </span>
                    <form action="" class="form-inline formsearch">
                        <div class="form-group">
                            <input type="text" class="form-control" id="" placeholder="{{search_placeholder}}">
                         <button type="submit" class="btn btn-default"><i class="fa fa-search" aria-hidden="true"></i></button>
                        </div>
                    </form>
                </div>
                <div class=" search-results animate fadeInUp"  data-wow-duration="600ms" >

               
            {{#each search_results_list}}
                    
                <article class="clearfix  result-article "
                         data-type ="{{type}}"  >
                        <div class="col-md-4 col-sm-4 col-xs-12  p-lr-0">
                          <div class="res-image">
                               <a href="{{link}}" ><img src="assets/img/search/{{img}}" alt=""></a> 
                          </div>
                        </div> 
                        <div class="col-md-8 col-sm-8 col-xs-12 p-0">
                            <div class="result-meta"> 
                            <span class="date">
                                <i class="fa fa-calendar-o"></i>{{date}} 
                            </span>
                            <span class="type" >{{type}}</span>
                            </div>
                            <h3 class="s-t"><a href="{{link}}">{{name}}</a></h3>
                             <p class="des">{{description}}</p>  
                               {{#if footer}}
                                <div class="result-footer">
                                    {{{footer}}}
                                </div>
                               {{/if}} 
                                <a href="{{link}}" class="morelink">
                                    <span>{{../more}}</span>
                                </a>
                        </div> 
                    </article>

            {{/each}}
             </div>
             {{>pagination}}
        </div>
        <div class="col-md-3 col-sm-4 col-xs-12">
            <div class="srch-results-lbl hidden-xs">
                <i class="fa fa-search"></i> <b>25502</b>
                <span>{{result_found}}</span>
            </div>
            {{>sidebar}}  
        </div>
    </div>
</div>
</section>
     {{>footer }}   
    <script src="assets/js/script.min.js"></script>
    <script src="assets/js/isotope.pkgd.min.js"></script>
    <script>
        $(document).ready(function(){
            if($(window).width() >= 760){
                $('.search-results').isotope({
                itemSelector: '.result-article',
                layoutMode: 'fitRows',
                getSortData: {
                name: '.s-t',
                type: '[data-type]'
                }
            });
                $('[data-sort]').click( function( event ) {
                    event.preventDefault();
                    var option =  $(this).data('sort');
                    $('.search-results').isotope( {sortBy : option} );
                });
            }
            })
         
    </script>
</body>
</html>
 