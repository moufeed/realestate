 <!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <title>{{pagetitle}}</title>
    <link rel="stylesheet" href="assets/css/style-{{dir}}.min.css">
    
</head>
<body>
    {{!-- {{>header }} --}}
   <section class="page_header">
         <div class="container"> 
             <div class="row">
                 <div class="col-sm-5 ">
                      <h1>{{title}}</h1>
                 </div>
                 <div class="col-sm-7 ">
                     <ol class="breadcrumb page-breadcrumb">
                    {{#isequal dir 'ltr'}}
                        <li><a href="index.html">{{home}}</a></li>
                    {{else}}
                        <li><a href="index-ltr.html">{{home}}</a></li>
                    {{/isequal}}
                    <li class="active">{{title}}</li>
                    </ol>
                 </div>
             </div> 
         </div>
     </section>
{{!-- http://sparrow-html.weblionmedia.net/hotel_list.html --}}
<section class="results-page">
<div class="container">
    <div class="row">
        <div class="col-md-9 col-sm-8 col-xs-12 search-results">
                
           
                
                    <article class="clearfix  result-article">
                        <div class="col-md-4 col-sm-4 col-xs-12  ">
                          <div class="res-image">
                               <a href="{{link}}" ><img src="assets/img/properties/1.jpg" alt=""></a> 
                          </div>
                        </div> 
                        <div class="col-md-8 col-sm-8 col-xs-12 p-0">
                            <div class="result-meta">
                            <span class="date">
                                <i class="fa fa-calendar-o"></i>Jan 21, 2017 
                            </span>
                            </div>
                            <h3 class="s-t"><a href="{{link}}">Marina Bakirkoy Residence</a></h3>
                             <p class="des">Wake up to the great view of the Princess Islands and the Historical Peninsula to make the sea a part of your daily life. Take advantage of giving yourself a great social opportunity </p>  
                              
                                <div class="result-footer">
                                    <span class="price"> <small>{{price}}</small> <b dir="ltr"> 20000  </b></span> 
                                    <span class="size"><small>{{size}}</small> 150 M<sup>2</sup></span> 
                                    <span class="rooms"><small>{{rooms}}</small> 6</span>
                                </div>
                              
                                <a href="{{link}}" class="morelink">
                                    <svg xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none" >
                                        <rect id="shape"/>
                                    </svg>
                                    <span>more</span>
                                </a>
                        </div> 
                    </article>
                 
             

        </div>
        <div class="col-md-3 col-sm-4 col-xs-12">
            <div class="srch-results-lbl">
                <i class="fa fa-search"></i> <b>25502</b>
                <span>{{result_found}}</span>
            </div>
            {{>sidebar}}  
        </div>
    </div>
</div>
</section>
     {{!-- {{>footer }}  --}}
    <script src="assets/js/script.min.js"></script>
</body>
</html>
