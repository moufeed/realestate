<section class="properties-page">
<div class="container">
    <div class="row">
        <div class="col-md-3 col-sm-4 col-xs-12">
                <!-- {{>sidebar}} -->
        </div>
        <div class="col-md-9 col-sm-8 col-xs-12">
          <div class="cleafix properties_list">
            {{#each properties }}
                  <div class="col-md-4 col-sm-6 colxs-12">
                      <article class="pro_item">
                          <div class="imgbox">
                            <!-- <div class="offers">
                                {{#if special}}
                                <span class="special" ><i class="fa fa-star"></i> {{special}}</span>
                                {{/if}}

                                {{#if type}}
                                    <span>{{type}}</span>
                                {{/if}}
                            </div> -->
                           <a href="{{link}}"> <img src="assets/img/properties/{{img}}" alt="{{name}}"></a>
                          </div>
                          <div class="prop_info">
                              <h4>{{name}}</h4>
                              <address >{{address}}</address>

                                <div class="prop_mate">
                                  {{#each meta}}
                                  <span>{{name}}  {{count}} </span>
                                    {{/each }}
                                </div>

                              <div class="prop_footer">
                                  <strong>{{price}}</strong>
                                  <a href="{{link}}" class="btn btn-more">{{../more}}</a>
                              </div>
                          </div>
                      </article>
                  </div>
            {{/each }}
          </div>

        </div>
    </div>
</div>
</section>
     <!-- {{>footer }}  -->
    <script src="assets/js/script.min.js"></script>
</body>
</html>
