<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <title>{{pagetitle}}</title>
    <link rel="stylesheet" href="assets/css/style-{{dir}}.min.css">
    
</head>
<body>
    {{>header }}
   <section class="page_header" data-parallax="scroll"   data-speed="0.3" data-image-src="assets/img/properties-bg.jpg">
         <div class="container"> 
             <div class="row">
                 <div class="col-sm-5 ">
                      <h1>{{title}}</h1>
                 </div>
                 <div class="col-sm-7 ">
                     <ol class="breadcrumb page-breadcrumb">
                    {{#isequal dir 'ltr'}}
                        <li><a href="index.html">{{home}}</a></li>
                    {{else}}
                        <li><a href="index-ltr.html">{{home}}</a></li>
                    {{/isequal}}
                    <li class="active">{{title}}</li>
                    </ol>
                 </div>
             </div> 
         </div>
     </section>

<section class="">
<div class="container">
    <div class="row">
        <div class="col-md-3 col-sm-4 col-xs-12">
                {{>sidebar}}
        </div>
        <div class="col-md-9 col-sm-8 col-xs-12">
          
        </div>
    </div>
</div>
</section>
     {{>footer }} 
    <script src="assets/js/script.min.js"></script>
</body>
</html>