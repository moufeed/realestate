<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <title>{{pagetitle}}</title>
    <link rel="stylesheet" href="assets/css/style-{{dir}}.min.css">
    {{>loader-scripts}}
</head>
<body>
    {{>header page_active='about' }}
   <section class="page_header" data-parallax="scroll"   data-speed="0.3" data-image-src="assets/img/aboutus-bg.jpg">
         <div class="container"> 
             <div class="row">
                 <div class="col-sm-5 ">
                      <h1>{{about_us}}</h1>
                 </div>
                 <div class="col-sm-7 ">
                     <ol class="breadcrumb page-breadcrumb">
                    {{#isequal dir 'ltr'}}
                        <li><a href="index.html">{{home}}</a></li>
                    {{else}}
                        <li><a href="index-ltr.html">{{home}}</a></li>
                    {{/isequal}}
                    <li class="active">{{about_us}}</li>
                    </ol>
                 </div>
             </div> 
         </div>
     </section>

<section class="about-orfali">
<div class="container">
    <div class="row row-flex">
        
        <div class="col-md-8 col-sm-7">
           <div class="about_contetn">
               <h3><strong>{{about_us}}</strong></h3>
               <p>{{about_section_body}}</p>
           </div>
        </div>
        <div class="col-md-4 col-sm-5 orfalilogo">
            <img src="assets/img/about-logo.png" class="img-responsive" alt="">
        </div>
    </div>
</div>
</section>
<section class="omvv">
    <div class="container">
        <div class="row flex-row">
            <div class="col-sm-6"> 
               <article class="mission">
                   <h3><strong>{{our_mission}}</strong></h3>
                   <P>{{mission_content}}</P>
               </article>
            </div>
            <div class="col-sm-6"> 
                <article class="vision">
                   <h3><strong>{{our_vision}}</strong></h3>
                     <P>{{vision_content}}</P>
                </article>
                <article class="values">
                   <h3><strong>{{our_values}}</strong></h3>
                    <P>{{values_content}}</P>
                </article>
            </div>
            
        </div>
    </div>
</section> 
{{>testimonials}}
{{>statistics}}
{{>footer }} 
    <script src="assets/js/script.min.js"></script>

</body>
</html>


