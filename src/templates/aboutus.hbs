<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <title>{{pagetitle}}</title>
    <link rel="stylesheet" href="assets/css/style-{{dir}}.min.css">
    {{>loader-scripts}}
</head>
<body>
    {{>header page_active='about' }}
   <section class="page_header" data-parallax="scroll"   data-speed="0.3" data-image-src="assets/img/aboutus-bg.jpg">
         <div class="container"> 
             <div class="row">
                 <div class="col-sm-5 ">
                      <h1>{{about_us}}</h1>
                 </div>
                 <div class="col-sm-7 ">
                     <ol class="breadcrumb page-breadcrumb">
                    {{#isequal dir 'ltr'}}
                        <li><a href="index.html">{{home}}</a></li>
                    {{else}}
                        <li><a href="index-ltr.html">{{home}}</a></li>
                    {{/isequal}}
                    <li class="active">{{about_us}}</li>
                    </ol>
                 </div>
             </div> 
         </div>
     </section>

<section class="about-orfali">
<div class="container">
    <div class="row row-flex">
        
        <div class="col-md-8 col-sm-7">
           <div class="about_contetn">
               <h3><strong>{{about_us}}</strong></h3>
               <p>{{about_section_body}}</p>
           </div>
        </div>
        <div class="col-md-4 col-sm-5 orfalilogo">
            <img src="assets/img/about-logo.png" class="img-responsive" alt="">
        </div>
    </div>
</div>
</section>

<section  class="testimonials" >
    <div class="container">
        <div class="row"> 
            <div class="col-md-12">
                    <div class="owl-carousel feedback_slider" id="testimonialsSlider" data-rtl="{{carousel.rtl}}" data-navleft="{{carousel.left}}" data-navright="{{carousel.right}}">
                        {{#each testimonial_List}}
                        <div class="testimonail-item">
                            <i class="fa fa-quote-left ico" aria-hidden="true"></i>
                                 <p>{{testimonial}}</p>
                            <div class="feed">
                                <strong>{{name}}</strong>
                                <small>{{occupation}}</small>
                            </div>
                        </div>  
                        {{/each}} 
                    </div>
            </div>
        </div>
    </div>
</section>
     {{>footer }} 
    <script src="assets/js/script.min.js"></script>

</body>
</html>