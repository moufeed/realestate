<section class="slider-section">
<div class="rev_slider_wrapper fullwidthbanner-container">
 
      
    <div id="main_slider" class="rev_slider fullwidthabanner" data-version="5.4.5" style="display:none">
 
        <ul>
 
             {{#each slider}}
                <li data-transition="random">
                    <img src="assets/img/slider/{{image}}" alt=""  class="rev-slidebg">

                    <div class="tp-caption main-des"
									data-x="{{#isequal ../dir 'ltr'}}50{{else}}1100{{/isequal}}"
									data-y="150"
									data-start="500"
									data-transform_in="y:[-300%];opacity:0;s:500;">
                                        <div class="prop-info">
                                           <header>
                                                <h3>{{name}}</h3>
                                                <span class="price">{{price}} <b>$</b></span>
                                                <span class="tag">{{type}}</span>
                                           </header>
                                            <ul class="list_info list-unstyled">
                                               {{#each properties}}
                                                 <li>
                                                    <div>
                                                        <i class="fa {{icon}}"></i>
                                                        <span>
                                                            <small>{{title}}</small>
                                                            <strong>{{val}}</strong>
                                                        </span>
                                                    </div> 
                                                </li>
                                               {{/each}}
                                            </ul>
                                        </div>
                                    </div>
 
                </li> 
            {{/each}}
        </ul>
   
    </div>
 
</div>
</section>
