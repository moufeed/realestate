<header class="main_header">
    <div class="container">
        <div class="row">
            <div class="col-md-3 col-sm-4">
                <a href="index-{{dir}}.html" class="main_logo animate fadeIn" data-wow-duration="400ms" data-wow-delay="100ms">
                    <img src="assets/img/logo-{{dir}}.png"  class="img-responsive" alt="logo">
                </a>
            </div>
            <div class="col-md-8 col-md-offset-1 col-sm-8">
                <div class="clearfix topbar">
                    <div class="hotline  col-md-7 col-sm-6  p-0 hidden-xs">
                        <span class="hidden-sm animate fadeIn" data-wow-duration="400ms" data-wow-delay="100ms">
                            <i class="fa fa-phone"></i> 05389498776 / 05386280000</span>
                        <a href="mailto:info@hussamorfali.com" class="animate fadeIn" data-wow-duration="400ms" data-wow-delay="100ms">
                            <i class="fa fa-envelope-o"></i> info@hussamorfali.com</a>
                    </div>
                    <ul class="list-unstyled list-inline social-list  col-md-5 col-sm-6 col-xs-12 p-0 animate fadeIn" data-wow-duration="400ms" data-wow-delay="200ms">
                        
                         <li>
                            <a href="#">
                                <i class="fa fa-search"></i>
                            </a>
                        </li>
                        {{#each sociallist}}
                        <li>
                            <a href="{{link}}">
                                <i class="fa {{icon}}"></i>
                            </a>
                        </li>
                        {{/each}}
                       
                    </ul>
                </div> 
            {{! -- ------- }}
            {{> navigation }}
            {{! -- ------- }}

            </div>
        </div>
    </div>
</header>