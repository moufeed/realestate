<aside class="sidebar">
    
    <form action="" class="sidebar-search">
        <h4 class="side-title"><strong>{{advanced_search}}</strong></h4> 
        <div class="form-group">
            <input type="text" name="" class="form-control" placeholder="{{keyword}}">
        </div>
        <div class="form-group"> 
            <select name="" id="" class="form-control select" >
                <option value="">{{city}}</option>
                {{#each cities}}
                    <option value="">{{this}}</option>
                {{/each}}
            </select>
        </div>
        <div class="form-group">
            <select name="" id="" class="form-control select"  >
                <option value="">{{type_label}}</option>
                {{#each real_estate_type}}
                    <option value="">{{this}}</option>
                {{/each}}
            </select>
        </div>
         <div class="form-group">
            <select name="" id="" class="form-control select" >
                  <option value="">{{rooms_count}}</option>
                 {{#for 1 11 1}}
                    <option value="">{{this}}</option>
                 {{/for}}
            </select>
        </div>
         <div class="form-group">
            <select name="" id="" class="form-control select" >
                  <option value="">{{salons_count}}</option>
                 {{#for 1 4 1}}
                    <option value="">{{this}}</option>
                 {{/for}}
            </select>
        </div>
         <div class="form-group">
            <select name="" id="" class="form-control select" >
                  <option value="">{{bathrooms_count}}</option>
                 {{#for 1 11 1}}
                    <option value="">{{this}}</option>
                 {{/for}}
            </select>
        </div>
         <div class="form-group">
             <label for="price">{{price_label}}</label>
            <div class="numbers-area">
                <span>{{from}}</span> <strong id="min-price">0</strong>
                <span>{{to}}</span> <strong id="max-price">10000</strong>
                <b>$</b>
            </div>
             <div id="price_slider" data-min="0" data-max="10000" data-values="250,5000" data-step="100"></div>
         </div>
          <div class="form-group">
             <label for="">{{area_label}}</label>
              <div class="numbers-area">
                <span>{{from}}</span> <strong id="min-size">0</strong>
                <span>{{to}}</span> <strong id="max-size">5000</strong>
                <b>M2</b>
              </div> 
             <div id="area_slider" data-min="0" data-max="5000" data-step="10"  data-values="250,3500" ></div>
         </div>
           <div class="form-group">
               <button type="submit" class="btn  btn-search">{{search}}</button>
              <button type="reset"  class="btn btn-reset" onclick="resetpicker();resetslider()">{{reset}}</button>
           </div>
    </form>
    <div class="featured_properties">
         <h4 class="side-title"><strong>{{featured_properties}}</strong></h4> 
    <div class="owl-carousel featured-slider" dir="ltr">
        {{#each_upto properties_list 4}}
        <div class="item">
            <figure>
                    <img src="assets/img/properties/{{img}}" alt="{{name}}" class="img-resposive">
                <figcaption>
                    <h4>{{name}}</h4>
                    <div>
                        <p>{{price}} $</p>
                    </div>
                    <a href="{{link}}"> {{../more}}</a>
                </figcaption>			
            </figure>
        </div>
        {{/each_upto}}
    </div>
</div>

<div class="latest-properties">
      <h4 class="side-title"><strong>{{latest_properties}}</strong></h4> 
      <ul class="list-unstyled latest-list">
          {{#each_fromto properties_list 2 3}}
          <li class="clearfix">
             <span class="img">
                 <a href="{{link}}"><img src="assets/img/properties/{{img}}" alt="{{name}}"></a>
             </span>
             <span class="info">
                 <h4><a href="{{link}}">{{name}}</a></h4>
                 <p>
                     <b>{{price}} </b> $
                 </p>
             </span>
          </li>
          {{/each_fromto}}
      </ul>
</div>
</aside>

  