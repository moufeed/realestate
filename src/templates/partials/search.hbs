<section class="section-search" 
data-parallax="scroll"   data-speed="0.3" data-image-src="assets/img/search-bg.jpg">
    <div class="container">
        <div class="row">
            <form action="" class=" form-search col-md-10 col-md-offset-1 col-sm-12 ">
                    <div class="clearfix">
                        <div class="form-group col-sm-4">
                            <label for="">{{search_label}}</label>
                            <input type="text" id="" name="" class="form-control" placeholder="{{search_placholder}}">
                        </div>
                        <div class="form-group col-sm-4">
                            <label for="">{{city}}</label>
                            <select name="" id="" class="form-control select"  placeholder="">
                                {{#each cities}}
                                    <option value="">{{this}}</option>
                                {{/each}}
                            </select>
                        </div>
                        <div class="form-group col-sm-4">
                            <label for="">{{type_label}}</label>
                            <select name="" id="" class="form-control select"  placeholder="">
                                {{#each real_estate_type}}
                                    <option value="">{{this}}</option>
                                {{/each}}
                            </select>
                        </div> 
                         
                         <div class="form-group col-sm-3">
                            <label for="">{{rooms_count}}</label>
                            <select name="" id="" class="form-control select"  placeholder="">
                                {{#for 1 11 1}}
                                    <option value="">{{this}}</option>
                                {{/for}}
                            </select>
                        </div> 
                        <div class="form-group col-sm-3">
                            <label for="">{{bathrooms_count}}</label>
                            <select name="" id="" class="form-control select"  placeholder="">
                                {{#for 1 11 1}}
                                    <option value="">{{this}}</option>
                                {{/for}}
                            </select>
                        </div> 
                        <div class="form-group col-md-2 col-sm-3">  
                            <label for="">{{price_label}}</label>
                            <input type="number" name="" id="" class="form-control"  placeholder="{{price_placeholder}}">
                        </div> 
                         <div class="form-group col-md-2 col-sm-3">
                            <label for="">{{area_label}}</label>
                            <input type="number" name="" id="" class="form-control"  placeholder="{{area_placeholder}}">
                        </div> 
                         <div class="form-group col-md-2 col-sm-12">
                             <button type="submit" class="btn btn-block  btn-search">{{search}}</button>
                        </div> 
                    </div>
            </form>
        </div>
    </div>
</section>