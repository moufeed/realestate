<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <title>{{pagetitle}}</title>
    <link rel="stylesheet" href="assets/css/style-{{dir}}.min.css">
    {{>loader-scripts}}
</head>
<body>
      {{>header page_active='news' }}  
   <section class="page_header" data-parallax="scroll" data-speed="0.3" data-image-src="assets/img/news-bg.jpg">
         <div class="container"> 
             <div class="row">
                 <div class="col-sm-5 ">
                      <h1>{{title}}</h1>
                 </div>
                 <div class="col-sm-7 ">
                     <ol class="breadcrumb page-breadcrumb">
                    {{#isequal dir 'ltr'}}
                        <li><a href="index.html">{{home}}</a></li>
                    {{else}}
                        <li><a href="index-ltr.html">{{home}}</a></li>
                    {{/isequal}}
                    <li class="active">{{title}}</li>
                    </ol>
                 </div>
             </div> 
         </div>
     </section>

<section class="news-page">
<div class="container">
    <div class="row">
          <div class="col-md-9 col-sm-8 col-xs-12 ">
             <div class="news-list">   
                {{#each blogs_list}}
                 <div class="news-item row animate fadeInUp" data-wow-duration="600ms" data-wow-delay="{{delay @index 70}}ms">
                        <div class="col-sm-6  col-xs-12 news-image">
                            <a href="{{link}}">
                                <img src="assets/img/news/{{img}}" alt="">
                            </a>
                        </div> 
                         <div class="col-sm-6  col-xs-12 news-info">
                             <div class="news-meta">
                                 <span class="date"><i class="fa fa-calendar-o"></i> {{date}}</span>
                                 <span class="user"><i class="fa fa-user-o"></i>{{author}}</span>
                                 <span class="type"><i class="fa fa-tag"></i> {{type}} </span>
                             </div>
                            <h4 class="ns-t"><a href="{{link}}">{{name}}</a></h4>
                            <p class="ns-d">
                                {{description}}
                            </p>
                            <hr class="gray-line">
                            <footer  class="n-f">
                                    <ul class="list-inline list-unstyled">
                                        <li><a href="#"><i class="fa fa-facebook"></i></a></li>
                                        <li><a href="#"><i class="fa fa-twitter"></i></a></li>
                                        <li><a href="#"><i class="fa fa-google-plus"></i></a></li>
                                        <li><a href="#"><i class="fa fa-linkedin"></i></a></li>
                                    </ul>
                                <a href="{{link}}" class="more">{{../read_more}}</a>
                            </footer>
                        </div>
                 </div>
        {{/each}}

                    
             </div>
          </div>
          <div class="col-md-3 col-sm-4 col-xs-12 ">
              {{>sidebar}}
          </div>
    </div>
</div>
</section>
     {{>footer }}   
    <script src="assets/js/script.min.js"></script>
</body>
</html>