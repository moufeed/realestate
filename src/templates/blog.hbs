<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <title>{{pagetitle}}</title>
    <link rel="stylesheet" href="assets/css/style-{{dir}}.min.css">
    
</head>
<body>
    {{!-- {{>header }} --}}
   <section class="page_header">
         <div class="container"> 
             <div class="row">
                 <div class="col-sm-5 ">
                      <h1>{{title}}</h1>
                 </div>
                 <div class="col-sm-7 ">
                     <ol class="breadcrumb page-breadcrumb">
                    {{#isequal dir 'ltr'}}
                        <li><a href="index.html">{{home}}</a></li>
                    {{else}}
                        <li><a href="index-ltr.html">{{home}}</a></li>
                    {{/isequal}}
                    <li class="active">{{title}}</li>
                    </ol>
                 </div>
             </div> 
         </div>
     </section>

<section class="blog-page">
<div class="container">
    <div class="row">
        <div class="col-md-9 col-sm-8 col-xs-12 ">
            <div class="blog-body">
            <div class="b-image">
                <img src="assets/img/blog/{{blog_content.img}}"  class="img-responsive" alt="">
            </div>
            <header class="b-h">
                <h2>
                    <strong>{{blog_content.name}}</strong>
                </h2>
                <div>
                    <span> <i class="fa fa-user-o"></i>{{blog_content.author}}</span>
                    <span><i class="fa fa-calendar-o"></i>{{blog_content.date}}</span>
                </div>
            </header>
            <div class="b-content">
                    <p>
                        {{blog_content.body.a}}
                    </p>
                    <h3>{{blog_content.body.h3}}</h3>
                    <p>
                        {{blog_content.body.b}}
                    </p>
                    <img src="assets/img/blog/{{blog_content.body.img}}" class="img-responsive" alt="">
                    <h4>{{blog_content.body.h4}}</h4>
                    <ul class="list-unstyled">
                        {{#each blog_content.body.list}}
                                <li>
                                    {{this}}
                                </li> 
                        {{/each}}
                    </ul>
            </div>
         </div>
         <div class="related_news">
             <h3 class="property-title mb-15">
                 <strong>{{related_posts}}</strong>
             </h3>
            <div class="row">
                {{#each_upto blogs_list 3}}
                    <div class="col-sm-4 ">
                        <article class="similar_property">
                            <a href="{{link}}" class="image">
                                <img src="assets/img/news/{{img}}" alt="{{name}}">
                            </a>
                            <h4><a href="{{link}}">{{name}}</a></h4>
                            <span> 
                                <i class="fa fa-calender-o"></i>
                                {{date}}
                            </span>
                        </article>
                    </div>
                {{/each_upto}}
            </div>
         </div>
        </div>
        <div class="col-md-3 col-sm-4 col-xs-12 ">
              {{>sidebar}}
        </div>
    </div>
</div>
</section>
     {{!-- {{>footer }}  --}}
    <script src="assets/js/script.min.js"></script>
</body>
</html>
